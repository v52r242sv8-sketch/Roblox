				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[-- Config: every balance number for Steal a Meteor lives here.
-- Change values here instead of hunting through the scripts.

local Config = {}

Config.GameName = "Steal a Meteor"
Config.DataStoreName = "StealAMeteor_v1"
Config.AutosaveInterval = 90

-- Speed ("+1 speed every second" on your Speed Pad)
Config.StartSpeed = 16
Config.MaxSpeed = 250
Config.PadBaseRate = 1 -- speed per second while standing on your own Speed Pad

-- Speed Boots upgrade: each level adds +1 speed/sec on the pad
Config.Boots = {
	MaxLevel = 12,
	BaseCost = 400,
	CostMult = 3,
}

-- Pedestals (slots on your base)
Config.PhysicalPedestals = 16 -- pedestals that exist on every plot
Config.StartPedestals = 6
Config.MaxBuyablePedestals = 14 -- VIP unlocks the last 2
Config.VipBonusPedestals = 2
Config.PedestalBaseCost = 750
Config.PedestalCostMult = 2.6

-- Rebirth: resets cash, speed and boots; keeps your Meteorlings and Index
Config.Rebirth = {
	BaseCost = 150000,
	CostMult = 6,
	BonusPerRebirth = 0.5, -- +50% income per rebirth
}

-- Index: each discovered Meteorling gives a permanent income bonus
Config.IndexBonusPerEntry = 0.02

-- Offline earnings
Config.OfflineCapSeconds = 2 * 60 * 60
Config.OfflineRate = 0.25

-- Selling
Config.SellHatchedSeconds = 20 -- sell price = income/sec * this
Config.SellMeteorMult = 0.25 -- unhatched meteors sell for less

-- Base lock (laser gate)
Config.Lock = {
	Duration = 45,
	VipDuration = 60,
	Cooldown = 60,
}

-- Hammer ("Bonk")
Config.Bonk = {
	Range = 9,
	BigRange = 14,
	Cooldown = 1.2,
	BigCooldown = 0.8,
	Knockback = 55,
	StunTime = 0.9,
}

-- Rarities, from worst to best
Config.Rarities = {
	{ Name = "Common", Color = Color3.fromRGB(205, 205, 205), HatchTime = 10, Weight = 0.05, Size = 2.6, GrabTime = 0.25 },
	{ Name = "Uncommon", Color = Color3.fromRGB(85, 220, 110), HatchTime = 20, Weight = 0.08, Size = 3.0, GrabTime = 0.3 },
	{ Name = "Rare", Color = Color3.fromRGB(70, 150, 255), HatchTime = 40, Weight = 0.12, Size = 3.5, GrabTime = 0.4 },
	{ Name = "Epic", Color = Color3.fromRGB(170, 85, 255), HatchTime = 75, Weight = 0.17, Size = 4.0, GrabTime = 0.5 },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 170, 30), HatchTime = 150, Weight = 0.22, Size = 4.8, GrabTime = 0.7 },
	{ Name = "Mythic", Color = Color3.fromRGB(255, 60, 110), HatchTime = 300, Weight = 0.28, Size = 5.6, GrabTime = 0.9 },
	{ Name = "Cosmic", Color = Color3.fromRGB(0, 240, 255), HatchTime = 600, Weight = 0.35, Size = 6.6, GrabTime = 1.2 },
	{ Name = "Secret", Color = Color3.fromRGB(20, 20, 30), HatchTime = 900, Weight = 0.42, Size = 7.8, GrabTime = 1.5 },
}

Config.RarityIndex = {}
for i, rarity in Config.Rarities do
	Config.RarityIndex[rarity.Name] = i
end

-- Mutations are rolled when a meteor hatches (luck increases the chance).
-- Listed rarest first: the roll checks them in this order.
Config.Mutations = {
	{ Name = "Void", Mult = 10, Chance = 0.002, Color = Color3.fromRGB(110, 0, 200) },
	{ Name = "Rainbow", Mult = 5, Chance = 0.01, Color = Color3.fromRGB(255, 90, 200) },
	{ Name = "Golden", Mult = 2, Chance = 0.04, Color = Color3.fromRGB(255, 205, 40) },
}

Config.MutationByName = {}
for _, mutation in Config.Mutations do
	Config.MutationByName[mutation.Name] = mutation
end

-- Meteorlings: the creatures that hatch out of meteors.
-- Feature controls the little model detail (Ears, Horns, Wings, Antenna, Crown, Fins).
Config.Meteorlings = {
	{ Id = "Pebblit", Rarity = "Common", Income = 2, Color = Color3.fromRGB(150, 140, 130), Feature = "Ears" },
	{ Id = "Dustbun", Rarity = "Common", Income = 3, Color = Color3.fromRGB(220, 200, 170), Feature = "Ears" },
	{ Id = "Rocklet", Rarity = "Common", Income = 4, Color = Color3.fromRGB(110, 110, 120), Feature = "Horns" },

	{ Id = "Glowmite", Rarity = "Uncommon", Income = 8, Color = Color3.fromRGB(140, 255, 120), Feature = "Antenna" },
	{ Id = "Moonsnail", Rarity = "Uncommon", Income = 11, Color = Color3.fromRGB(200, 220, 255), Feature = "Antenna" },
	{ Id = "Fizzlefly", Rarity = "Uncommon", Income = 14, Color = Color3.fromRGB(255, 240, 120), Feature = "Wings" },

	{ Id = "Craterpup", Rarity = "Rare", Income = 35, Color = Color3.fromRGB(180, 120, 80), Feature = "Ears" },
	{ Id = "Sparkat", Rarity = "Rare", Income = 45, Color = Color3.fromRGB(90, 170, 255), Feature = "Ears" },
	{ Id = "Cometoad", Rarity = "Rare", Income = 60, Color = Color3.fromRGB(60, 200, 160), Feature = "Antenna" },

	{ Id = "Novabun", Rarity = "Epic", Income = 160, Color = Color3.fromRGB(255, 150, 220), Feature = "Ears" },
	{ Id = "Lunamoth", Rarity = "Epic", Income = 210, Color = Color3.fromRGB(190, 160, 255), Feature = "Wings" },
	{ Id = "Orbitron", Rarity = "Epic", Income = 275, Color = Color3.fromRGB(120, 120, 255), Feature = "Antenna" },

	{ Id = "Quasarfox", Rarity = "Legendary", Income = 900, Color = Color3.fromRGB(255, 130, 40), Feature = "Ears" },
	{ Id = "Solflare Drake", Rarity = "Legendary", Income = 1200, Color = Color3.fromRGB(255, 90, 30), Feature = "Wings" },
	{ Id = "Nebulynx", Rarity = "Legendary", Income = 1600, Color = Color3.fromRGB(150, 60, 255), Feature = "Horns" },

	{ Id = "Eclipsoid", Rarity = "Mythic", Income = 6000, Color = Color3.fromRGB(40, 30, 60), Feature = "Crown" },
	{ Id = "Starwhale", Rarity = "Mythic", Income = 8500, Color = Color3.fromRGB(60, 120, 255), Feature = "Fins" },
	{ Id = "Pulsaroo", Rarity = "Mythic", Income = 11000, Color = Color3.fromRGB(255, 60, 140), Feature = "Ears" },

	{ Id = "Galaxeon", Rarity = "Cosmic", Income = 45000, Color = Color3.fromRGB(90, 40, 200), Feature = "Wings" },
	{ Id = "Voidmaw", Rarity = "Cosmic", Income = 65000, Color = Color3.fromRGB(20, 0, 40), Feature = "Horns" },
	{ Id = "Chronostar", Rarity = "Cosmic", Income = 90000, Color = Color3.fromRGB(0, 220, 255), Feature = "Crown" },

	{ Id = "The Singularity", Rarity = "Secret", Income = 500000, Color = Color3.fromRGB(10, 10, 10), Feature = "Crown" },
	{ Id = "Big Bang Bob", Rarity = "Secret", Income = 750000, Color = Color3.fromRGB(255, 255, 255), Feature = "Horns" },
	{ Id = "Mr. Supernova", Rarity = "Secret", Income = 1200000, Color = Color3.fromRGB(255, 220, 80), Feature = "Crown" },
}

Config.MeteorlingById = {}
Config.MeteorlingsByRarity = {}
for _, info in Config.Meteorlings do
	Config.MeteorlingById[info.Id] = info
	Config.MeteorlingsByRarity[info.Rarity] = Config.MeteorlingsByRarity[info.Rarity] or {}
	table.insert(Config.MeteorlingsByRarity[info.Rarity], info)
end

-- Map
Config.MapHalfWidth = 210
Config.PlotSize = Vector3.new(60, 0, 70)
Config.PlotCount = 6
Config.PlotSpacing = 70
Config.PlotCenterZ = -40

-- Zones in front of the bases. Further zone = rarer meteors, higher speed needed.
Config.Zones = {
	{
		Name = "Meadow",
		ZMin = 70,
		ZMax = 220,
		Speed = 0,
		Color = Color3.fromRGB(95, 170, 80),
		Material = Enum.Material.Grass,
		Interval = 4,
		MaxActive = 12,
		Weights = { Common = 70, Uncommon = 25, Rare = 5 },
	},
	{
		Name = "Crater Dunes",
		ZMin = 240,
		ZMax = 400,
		Speed = 40,
		Color = Color3.fromRGB(225, 190, 120),
		Material = Enum.Material.Sand,
		Interval = 6,
		MaxActive = 8,
		Weights = { Uncommon = 40, Rare = 40, Epic = 18, Legendary = 2 },
	},
	{
		Name = "Lava Rift",
		ZMin = 420,
		ZMax = 590,
		Speed = 90,
		Color = Color3.fromRGB(60, 45, 45),
		Material = Enum.Material.Basalt,
		Interval = 9,
		MaxActive = 6,
		Weights = { Epic = 45, Legendary = 40, Mythic = 13, Cosmic = 2 },
	},
	{
		Name = "Cosmic Void",
		ZMin = 610,
		ZMax = 800,
		Speed = 160,
		Color = Color3.fromRGB(35, 20, 70),
		Material = Enum.Material.Glass,
		Interval = 13,
		MaxActive = 4,
		Weights = { Legendary = 35, Mythic = 45, Cosmic = 18, Secret = 2 },
	},
}

-- Meteor behaviour
Config.Meteor = {
	WarningTime = 3, -- seconds the red impact circle shows before the hit
	FallTime = 1.2,
	GroundLifetime = 60, -- seconds an untouched meteor stays on the ground
	DropLifetime = 45, -- seconds a dropped meteor stays before vanishing
	StolenPenalty = 0.1, -- extra slowdown while carrying something stolen
}

-- Server events
Config.Events = {
	MinGap = 300,
	MaxGap = 420,
	ShowerDuration = 60,
	ShowerSpawnMult = 3,
	ShowerMutationMult = 2,
	CometChance = 0.4, -- chance an automatic event is a Golden Comet instead of a shower
}

-- Monetization. Create the passes/products on the Creator Dashboard and paste the IDs here.
-- An ID of 0 means "not set up yet": the button tells the player it is coming soon.
Config.GamePasses = {
	DoubleMoney = { Id = 0, Name = "2x Cash", Description = "Double all income forever.", Price = 199 },
	DoubleSpeed = { Id = 0, Name = "2x Speed Pad", Description = "Your Speed Pad gives twice the speed.", Price = 149 },
	VIP = { Id = 0, Name = "VIP", Description = "+2 pedestals, +25% luck, longer base lock, gold tag.", Price = 299 },
	AutoCollect = { Id = 0, Name = "Auto Collect", Description = "Cash goes straight to your wallet.", Price = 99 },
	BigHammer = { Id = 0, Name = "Mega Hammer", Description = "Bigger bonk range, faster swings.", Price = 129 },
}

Config.Products = {
	SpeedBoost = { Id = 0, Name = "+50 Speed", Description = "Instantly gain 50 speed.", Price = 25 },
	InstantHatch = { Id = 0, Name = "Instant Hatch", Description = "Hatch every meteor on your base now.", Price = 49 },
	Luck = { Id = 0, Name = "2x Luck (15 min)", Description = "Double mutation luck for 15 minutes.", Price = 59 },
	MeteorShower = { Id = 0, Name = "Summon Meteor Shower", Description = "Start a server-wide meteor shower. Everyone sees your name!", Price = 99 },
	GoldenComet = { Id = 0, Name = "Summon Golden Comet", Description = "Drop a guaranteed Golden comet. The whole server will race for it!", Price = 149 },
}

Config.LuckDuration = 15 * 60
Config.VipLuck = 1.25

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8905A10B39C04B8DAAE81A868807BAA1">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[-- Creates (server) or waits for (client) every remote the game uses.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- server -> client: toast message
	"Sync", -- server -> client: player state snapshot
	"Banner", -- server -> all: big event banner
	"Knockback", -- server -> client: you got bonked
	"Effect", -- server -> client: small visual/sound cue
}

local FUNCTIONS = {
	"Request", -- client -> server: shop / rebirth actions
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX830B2EFFC8C64A20B8BA9A6084D60D8B">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[-- Small helpers shared by server and client.

local Config = require(script.Parent.Config)

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Util.FormatNumber(value)
	local n = tonumber(value) or 0
	local negative = n < 0
	if negative then
		n = -n
	end

	local text
	if n < 1000 then
		text = tostring(math.floor(n))
	else
		local index = 1
		while n >= 1000 and index < #SUFFIXES do
			n = n / 1000
			index += 1
		end
		if n >= 100 then
			text = string.format("%.0f", n)
		elseif n >= 10 then
			text = string.format("%.1f", n)
		else
			text = string.format("%.2f", n)
		end
		if string.find(text, "%.") then
			text = string.gsub(text, "0+$", "")
			text = string.gsub(text, "%.$", "")
		end
		text ..= SUFFIXES[index]
	end

	if negative then
		return "-" .. text
	end
	return text
end

function Util.FormatMoney(value)
	return "$" .. Util.FormatNumber(value)
end

function Util.FormatTime(seconds)
	local s = math.max(0, math.floor(seconds))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, sec)
	end
	return string.format("%ds", sec)
end

function Util.GetRarity(name)
	return Config.Rarities[Config.RarityIndex[name] or 1]
end

function Util.GetMeteorling(id)
	return Config.MeteorlingById[id]
end

-- Income per second of one item, before player multipliers.
function Util.ItemIncome(item)
	local info = Config.MeteorlingById[item.id]
	if not info then
		return 0
	end
	local mult = 1
	if item.mut and Config.MutationByName[item.mut] then
		mult = Config.MutationByName[item.mut].Mult
	end
	return info.Income * mult
end

function Util.BootsCost(level)
	return math.floor(Config.Boots.BaseCost * Config.Boots.CostMult ^ level)
end

function Util.PedestalCost(owned)
	return math.floor(Config.PedestalBaseCost * Config.PedestalCostMult ^ (owned - Config.StartPedestals))
end

function Util.RebirthCost(rebirths)
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostMult ^ rebirths)
end

function Util.RebirthMultiplier(rebirths)
	return 1 + Config.Rebirth.BonusPerRebirth * rebirths
end

-- Weighted random pick from a { key = weight } table.
function Util.WeightedPick(weights, rng)
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll
	if rng then
		roll = rng:NextNumber() * total
	else
		roll = math.random() * total
	end
	local fallback = nil
	for key, weight in weights do
		fallback = key
		roll -= weight
		if roll <= 0 then
			return key
		end
	end
	return fallback
end

function Util.CountKeys(tbl)
	local count = 0
	for _ in tbl do
		count += 1
	end
	return count
end

return Util
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX650ED763DCF548BE9AD8A87F8C1D8F8B">
				<Properties>
					<string name="Name">Visuals</string>
					<ProtectedString name="Source"><![CDATA[-- Visuals: builds every model in code (meteors, Meteorlings, hammer, warning circles).
-- Shared so the client can render the same models inside ViewportFrames (Index, hatch popup).

local CollectionService = game:GetService("CollectionService")

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local Visuals = {}

local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in props do
		inst[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
Visuals.Make = make

-- A part welded to the root. The CFrame is set BEFORE welding:
-- setting CFrame on an already welded part would move the whole assembly.
local function attachedPart(root, props, cframe)
	local part = make("Part", props)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = props.CastShadow ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = cframe
	part.Parent = root.Parent
	make("WeldConstraint", { Part0 = root, Part1 = part }, part)
	return part
end

local function ball(root, size, color, material, cframe, extra)
	local props = {
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	}
	if extra then
		for key, value in extra do
			props[key] = value
		end
	end
	return attachedPart(root, props, cframe)
end

local function newRoot(model, props)
	local root = make("Part", props)
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = true
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = model
	model.PrimaryPart = root
	return root
end

local function label(parent, props)
	local lbl = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = FONT,
		TextScaled = true,
		TextColor3 = WHITE,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	})
	for key, value in props do
		lbl[key] = value
	end
	lbl.Parent = parent
	return lbl
end
Visuals.Label = label

local function sparkles(parent, color, rate, size)
	return make("ParticleEmitter", {
		Name = "Sparkles",
		Color = ColorSequence.new(color),
		LightEmission = 1,
		LightInfluence = 0,
		Rate = rate,
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 2, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0, 0.4),
		Texture = SPARKLE,
	}, parent)
end

local function addMutationLook(model, root, item, plain)
	if not item.mut then
		return
	end
	local mutation = Config.MutationByName[item.mut]
	if not mutation then
		return
	end
	if plain then
		return
	end
	make("Highlight", {
		FillColor = mutation.Color,
		FillTransparency = 0.6,
		OutlineColor = mutation.Color,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.Occluded,
	}, model)
	sparkles(root, mutation.Color, 14, 0.6)
end

-- Billboard above an item: name, rarity, mutation, income or hatch timer.
local function itemBillboard(root, item, height, showIncome)
	local info = Config.MeteorlingById[item.id]
	local rarity = Util.GetRarity(info.Rarity)

	local gui = make("BillboardGui", {
		Name = "ItemGui",
		Size = UDim2.new(8, 0, 3.4, 0),
		StudsOffsetWorldSpace = Vector3.new(0, height / 2 + 2.4, 0),
		MaxDistance = 120,
		LightInfluence = 0,
	}, root)

	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0.02, 0),
	}, gui)

	if item.mut then
		local mutation = Config.MutationByName[item.mut]
		label(gui, {
			Name = "Mutation",
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0.22, 0),
			Text = "✦ " .. string.upper(item.mut) .. " x" .. tostring(mutation and mutation.Mult or 1) .. " ✦",
			TextColor3 = mutation and mutation.Color or WHITE,
		})
	end

	local nameText = item.id
	if not item.hatched then
		nameText = rarity.Name .. " Meteor"
	end
	label(gui, {
		Name = "Title",
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0.3, 0),
		Text = nameText,
	})

	local rarityLabel = label(gui, {
		Name = "Rarity",
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0.22, 0),
		Text = rarity.Name,
		TextColor3 = rarity.Color,
	})
	if rarity.Name == "Secret" then
		rarityLabel.TextColor3 = WHITE
		rarityLabel.TextStrokeColor3 = Color3.fromRGB(255, 0, 200)
	end

	if showIncome then
		if item.hatched then
			label(gui, {
				Name = "Income",
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0.26, 0),
				Text = Util.FormatMoney(Util.ItemIncome(item)) .. "/s",
				TextColor3 = Color3.fromRGB(120, 255, 120),
			})
		elseif item.hatchAt then
			local timer = label(gui, {
				Name = "Timer",
				LayoutOrder = 4,
				Size = UDim2.new(1, 0, 0.26, 0),
				Text = "Hatching...",
				TextColor3 = Color3.fromRGB(255, 230, 120),
			})
			timer:SetAttribute("HatchAt", item.hatchAt)
			CollectionService:AddTag(timer, "HatchTimer")
		end
	end
	return gui
end

-- Meteor -----------------------------------------------------------------------

-- An unhatched meteor: a molten glowing core showing through cracks in a rocky shell.
-- plain = true builds only the parts (for ViewportFrames).
function Visuals.MeteorModel(item, showIncome, plain)
	local info = Config.MeteorlingById[item.id]
	local rarity = Util.GetRarity(info.Rarity)
	local size = rarity.Size

	local model = Instance.new("Model")
	model.Name = "Meteor"
	local root = newRoot(model, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size * 0.82, size * 0.82, size * 0.82),
		Material = Enum.Material.Neon,
		Color = rarity.Color,
		CastShadow = false,
	})

	-- Rock plates: big enough to cover most of the core, gaps leak light
	local rng = Random.new(#item.id * 31 + math.floor(size * 10))
	local rockColor = Color3.fromRGB(48, 42, 44)
	local directions = {
		Vector3.new(1, 0, 0),
		Vector3.new(-1, 0, 0),
		Vector3.new(0, 1, 0),
		Vector3.new(0, -1, 0),
		Vector3.new(0, 0, 1),
		Vector3.new(0, 0, -1),
		Vector3.new(0.7, 0.7, 0),
		Vector3.new(-0.7, 0.7, 0),
		Vector3.new(0, 0.7, 0.7),
		Vector3.new(0, -0.7, -0.7),
		Vector3.new(0.7, -0.7, 0),
		Vector3.new(-0.7, 0, 0.7),
	}
	for i, direction in directions do
		local dir = direction.Unit
		local plate = Vector3.new(size * rng:NextNumber(0.42, 0.55), size * 0.18, size * rng:NextNumber(0.42, 0.55))
		local position = dir * size * 0.36
		local up = Vector3.new(0, 1, 0)
		if math.abs(dir.Y) > 0.9 then
			up = Vector3.new(1, 0, 0)
		end
		local cf = CFrame.lookAt(position, position + dir, up) * CFrame.Angles(math.rad(90), rng:NextNumber(0, math.pi), 0)
		attachedPart(root, {
			Name = "Rock" .. i,
			Size = plate,
			Material = Enum.Material.Basalt,
			Color = rockColor:Lerp(rarity.Color, 0.08),
		}, cf)
	end

	if not plain then
		make("PointLight", {
			Color = rarity.Color,
			Range = math.min(40, size * 4),
			Brightness = 3,
			Shadows = false,
		}, root)
		make("ParticleEmitter", {
			Name = "Embers",
			Color = ColorSequence.new(rarity.Color, Color3.fromRGB(255, 150, 60)),
			LightEmission = 1,
			LightInfluence = 0,
			Rate = 5 + Config.RarityIndex[rarity.Name] * 2,
			Lifetime = NumberRange.new(0.8, 1.6),
			Speed = NumberRange.new(1, 3),
			SpreadAngle = Vector2.new(60, 60),
			Acceleration = Vector3.new(0, 6, 0),
			EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.12), NumberSequenceKeypoint.new(1, 0) }),
			Texture = SPARKLE,
		}, root)
		make("ParticleEmitter", {
			Name = "Heat",
			Color = ColorSequence.new(rarity.Color),
			LightEmission = 0.8,
			LightInfluence = 0,
			Rate = 4,
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(0.5, 1),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.9), NumberSequenceKeypoint.new(1, size * 1.4) }),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.85),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Texture = FIRE,
			ZOffset = -1,
		}, root)
		if rarity.Name == "Secret" or rarity.Name == "Cosmic" then
			make("Highlight", {
				FillTransparency = 1,
				OutlineColor = rarity.Name == "Secret" and WHITE or rarity.Color,
				DepthMode = Enum.HighlightDepthMode.Occluded,
			}, model)
		end
		addMutationLook(model, root, item, plain)
		itemBillboard(root, item, size, showIncome)
		CollectionService:AddTag(root, "Spin")
	end
	return model
end

-- Meteorlings ------------------------------------------------------------------

local FEATURES = {}

function FEATURES.Ears(root, s, color, accent)
	for _, side in { -1, 1 } do
		local ear = attachedPart(root, {
			Size = Vector3.new(0.55 * s, 1.15 * s, 0.4 * s),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
		}, root.CFrame * CFrame.new(side * 0.72 * s, 1.55 * s, 0.1 * s) * CFrame.Angles(0, 0, -side * 0.35))
		attachedPart(root, {
			Size = Vector3.new(0.3 * s, 0.75 * s, 0.1 * s),
			Color = accent,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}, ear.CFrame * CFrame.new(0, -0.05 * s, -0.2 * s))
	end
end

function FEATURES.Horns(root, s, _color, accent)
	for _, side in { -1, 1 } do
		local base = attachedPart(root, {
			Size = Vector3.new(0.42 * s, 0.6 * s, 0.42 * s),
			Color = accent,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}, root.CFrame * CFrame.new(side * 0.6 * s, 1.35 * s, -0.25 * s) * CFrame.Angles(-0.25, 0, -side * 0.45))
		attachedPart(root, {
			Size = Vector3.new(0.26 * s, 0.6 * s, 0.26 * s),
			Color = accent:Lerp(WHITE, 0.4),
			Material = Enum.Material.Neon,
			CastShadow = false,
		}, base.CFrame * CFrame.new(0, 0.5 * s, 0) * CFrame.Angles(0, 0, -side * 0.35))
	end
end

function FEATURES.Wings(root, s, color, accent)
	for _, side in { -1, 1 } do
		local wing = attachedPart(root, {
			Size = Vector3.new(2 * s, 0.12 * s, 1.2 * s),
			Color = accent,
			Material = Enum.Material.Neon,
			Transparency = 0.25,
			CastShadow = false,
		}, root.CFrame * CFrame.new(side * 1.9 * s, 0.45 * s, 0.45 * s) * CFrame.Angles(0.15, side * 0.25, side * 0.5))
		attachedPart(root, {
			Size = Vector3.new(1.6 * s, 0.2 * s, 0.35 * s),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
		}, wing.CFrame * CFrame.new(0, 0.05 * s, -0.5 * s))
	end
end

function FEATURES.Antenna(root, s, _color, accent)
	for _, side in { -1, 1 } do
		local stalk = attachedPart(root, {
			Size = Vector3.new(0.12 * s, 1.1 * s, 0.12 * s),
			Color = Color3.fromRGB(40, 40, 50),
			Material = Enum.Material.SmoothPlastic,
		}, root.CFrame * CFrame.new(side * 0.45 * s, 1.75 * s, 0) * CFrame.Angles(0, 0, -side * 0.3))
		ball(root, 0.5 * s, accent, Enum.Material.Neon, stalk.CFrame * CFrame.new(0, 0.6 * s, 0), { CastShadow = false })
	end
end

function FEATURES.Crown(root, s)
	local gold = Color3.fromRGB(255, 205, 50)
	attachedPart(root, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35 * s, 1.5 * s, 1.5 * s),
		Color = gold,
		Material = Enum.Material.Metal,
		Reflectance = 0.2,
	}, root.CFrame * CFrame.new(0, 1.45 * s, 0) * CFrame.Angles(0, 0, math.rad(90)))
	for i = 0, 4 do
		local angle = (i / 5) * math.pi * 2
		local spike = CFrame.new(math.cos(angle) * 0.6 * s, 1.85 * s, math.sin(angle) * 0.6 * s)
		attachedPart(root, {
			Size = Vector3.new(0.22 * s, 0.6 * s, 0.22 * s),
			Color = gold,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
		}, root.CFrame * spike * CFrame.Angles(0, -angle, 0))
		ball(root, 0.2 * s, Color3.fromRGB(255, 80, 120), Enum.Material.Neon, root.CFrame * spike * CFrame.new(0, 0.35 * s, 0), {
			CastShadow = false,
		})
	end
end

function FEATURES.Fins(root, s, color, accent)
	attachedPart(root, {
		Size = Vector3.new(0.2 * s, 1.2 * s, 1.3 * s),
		Color = accent,
		Material = Enum.Material.Neon,
		CastShadow = false,
	}, root.CFrame * CFrame.new(0, 1.45 * s, 0.35 * s) * CFrame.Angles(0.5, 0, 0))
	attachedPart(root, {
		Size = Vector3.new(2 * s, 0.22 * s, 1 * s),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	}, root.CFrame * CFrame.new(0, 0.25 * s, 1.75 * s) * CFrame.Angles(0.25, 0, 0))
end

-- A hatched Meteorling: round glossy body, big shiny eyes, blush, feet, a signature feature.
function Visuals.CreatureModel(item, showIncome, plain)
	local info = Config.MeteorlingById[item.id]
	local rarity = Util.GetRarity(info.Rarity)
	local rarityIndex = Config.RarityIndex[info.Rarity]
	local s = 0.85 + rarityIndex * 0.17
	local bodySize = 3 * s
	local bodyColor = info.Color

	local model = Instance.new("Model")
	model.Name = "Meteorling"
	local root = newRoot(model, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(bodySize, bodySize, bodySize),
		Material = Enum.Material.SmoothPlastic,
		Color = bodyColor,
		Reflectance = 0.05,
	})

	-- Belly
	ball(root, 1.7 * s, bodyColor:Lerp(WHITE, 0.4), nil, root.CFrame * CFrame.new(0, -0.5 * s, -0.62 * s))

	-- Eyes
	for _, side in { -1, 1 } do
		local eye = ball(root, 0.95 * s, WHITE, nil, root.CFrame * CFrame.new(side * 0.55 * s, 0.38 * s, -1.18 * s))
		local pupil = ball(root, 0.55 * s, Color3.fromRGB(20, 18, 30), nil, eye.CFrame * CFrame.new(0, -0.03 * s, -0.27 * s))
		ball(root, 0.2 * s, WHITE, Enum.Material.Neon, pupil.CFrame * CFrame.new(0.12 * s, 0.13 * s, -0.2 * s), {
			CastShadow = false,
		})
		-- Blush
		ball(root, 0.42 * s, Color3.fromRGB(255, 120, 150), nil, root.CFrame * CFrame.new(side * 0.95 * s, -0.12 * s, -1.08 * s), {
			Transparency = 0.35,
			CastShadow = false,
		})
		-- Feet
		attachedPart(root, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5 * s, 0.9 * s, 0.9 * s),
			Color = bodyColor:Lerp(Color3.new(0, 0, 0), 0.25),
			Material = Enum.Material.SmoothPlastic,
		}, root.CFrame * CFrame.new(side * 0.6 * s, -1.35 * s, -0.35 * s) * CFrame.Angles(0, 0, math.rad(90)))
		-- Little arms
		ball(root, 0.6 * s, bodyColor:Lerp(Color3.new(0, 0, 0), 0.1), nil, root.CFrame * CFrame.new(side * 1.4 * s, -0.35 * s, -0.4 * s))
	end

	-- Mouth
	attachedPart(root, {
		Size = Vector3.new(0.45 * s, 0.14 * s, 0.1 * s),
		Color = Color3.fromRGB(70, 20, 40),
		Material = Enum.Material.SmoothPlastic,
	}, root.CFrame * CFrame.new(0, -0.18 * s, -1.47 * s) * CFrame.Angles(-0.25, 0, 0))

	local feature = FEATURES[info.Feature]
	if feature then
		feature(root, s, bodyColor, rarity.Color)
	end

	if not plain then
		if rarityIndex >= 4 then
			-- Magic aura bubble
			ball(root, bodySize * 1.25, rarity.Color, Enum.Material.ForceField, root.CFrame, { CastShadow = false })
		end
		if rarityIndex >= 5 then
			make("PointLight", { Color = rarity.Color, Range = 12 + rarityIndex * 2, Brightness = 1.5 }, root)
		end
		if rarityIndex >= 6 then
			sparkles(root, rarity.Color, 8, 0.45)
		end
		addMutationLook(model, root, item, plain)
		itemBillboard(root, item, bodySize + 1.5 * s, showIncome)
	end
	return model
end

function Visuals.ItemModel(item, showIncome, plain)
	if item.hatched then
		return Visuals.CreatureModel(item, showIncome, plain)
	end
	return Visuals.MeteorModel(item, showIncome, plain)
end

-- Effects ------------------------------------------------------------------------

-- Impact target: red ring + inner disc that the client shrinks as a countdown.
function Visuals.WarningCircle(diameter, color)
	local circle = make("Part", {
		Name = "ImpactWarning",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, diameter, diameter),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 40, 40),
		Transparency = 0.45,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	})
	local inner = make("Part", {
		Name = "Inner",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, diameter, diameter),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.2,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	}, circle)
	make("PointLight", { Color = Color3.fromRGB(255, 60, 60), Range = diameter, Brightness = 2 }, circle)
	return circle, inner
end

-- Tall light beam marking a special meteor (Golden Comet).
function Visuals.Beacon(position, color)
	local beacon = make("Part", {
		Name = "Beacon",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(600, 4, 4),
		CFrame = CFrame.new(position + Vector3.new(0, 300, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = color,
		Transparency = 0.4,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	})
	make("ParticleEmitter", {
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Rate = 40,
		Lifetime = NumberRange.new(2, 3),
		Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new(1.2, 0),
		Texture = SPARKLE,
		EmissionDirection = Enum.NormalId.Right,
	}, beacon)
	return beacon
end

function Visuals.HammerTool(big)
	local tool = Instance.new("Tool")
	tool.Name = "Hammer"
	tool.ToolTip = "Bonk players to make them drop what they carry!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, -1.2, 0)

	local scale = 1
	local headColor = Color3.fromRGB(255, 120, 40)
	if big then
		scale = 1.5
		headColor = Color3.fromRGB(255, 210, 40)
	end

	local handle = make("Part", {
		Name = "Handle",
		Size = Vector3.new(0.45, 4 * scale, 0.45),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(110, 70, 40),
		CanCollide = false,
		Massless = true,
	}, tool)

	local function piece(props, offset)
		local p = make("Part", props)
		p.CanCollide = false
		p.Massless = true
		p.CFrame = handle.CFrame * offset
		p.Parent = tool
		make("WeldConstraint", { Part0 = handle, Part1 = p }, p)
		return p
	end

	piece({
		Name = "Head",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6 * scale, 1.5 * scale, 1.5 * scale),
		Material = Enum.Material.SmoothPlastic,
		Color = headColor,
	}, CFrame.new(0, 2 * scale, 0))
	for _, side in { -1, 1 } do
		piece({
			Name = "Band",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.25 * scale, 1.6 * scale, 1.6 * scale),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 240, 200),
		}, CFrame.new(side * 1.05 * scale, 2 * scale, 0))
	end
	piece({
		Name = "Grip",
		Size = Vector3.new(0.55, 1.2 * scale, 0.55),
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(40, 40, 50),
	}, CFrame.new(0, -1.3 * scale, 0))

	make("Sound", { Name = "Swing", SoundId = "rbxasset://sounds/swordslash.wav", Volume = 0.6 }, handle)
	make("Sound", { Name = "Hit", SoundId = "rbxasset://sounds/hit.wav", Volume = 0.9 }, handle)
	return tool
end

return Visuals
]]></ProtectedString>
